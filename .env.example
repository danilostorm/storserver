# StorServer
APP_ENV=development
APP_NAME=StorServer
API_HOST=0.0.0.0
API_PORT=8000
FRONTEND_ORIGIN=http://localhost:3000

# Authentication
JWT_SECRET=change-this-to-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=60
ADMIN_EMAIL=admin@hoststorm.cloud
ADMIN_PASSWORD=change-this-now

# Database
POSTGRES_DB=storserver
POSTGRES_USER=storserver
POSTGRES_PASSWORD=change-this-db-password
DATABASE_URL=postgresql+psycopg://storserver:change-this-db-password@postgres:5432/storserver

# Redis
REDIS_URL=redis://redis:6379/0

# Local agent / node bootstrap
AGENT_SHARED_TOKEN=change-this-agent-token
AGENT_URL=http://agent:9000
NODE_NAME=storserver-local
NODE_REGION=lab

# Public websites
PUBLIC_BASE_DOMAIN=hoststorm.cloud
PANEL_HOST=panel.hoststorm.cloud
