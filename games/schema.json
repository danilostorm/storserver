{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "StorServer game template",
  "type": "object",
  "required": ["key", "name", "enabled", "image", "ports"],
  "properties": {
    "key": { "type": "string" },
    "name": { "type": "string" },
    "enabled": { "type": "boolean" },
    "installer": { "type": "string" },
    "steam_app_id": { "type": ["integer", "null"] },
    "image": { "type": "string" },
    "command": { "type": ["string", "array", "null"] },
    "environment": { "type": "object", "additionalProperties": true },
    "ports": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["container", "protocol", "role"],
        "properties": {
          "container": { "type": "integer", "minimum": 1, "maximum": 65535 },
          "protocol": { "enum": ["tcp", "udp"] },
          "role": { "type": "string" },
          "preferred_host": { "type": ["integer", "null"], "minimum": 1, "maximum": 65535 }
        }
      }
    },
    "volumes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["container"],
        "properties": {
          "container": { "type": "string" },
          "host_subdir": { "type": "string" },
          "mode": { "enum": ["ro", "rw"] }
        }
      }
    }
  }
}
